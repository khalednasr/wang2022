// Determine strength of argument to within epsilon, that excites cell.
func thresh_excited() { local ind_valid_AP1, ind_valid_AP2, count_burst, in_burst, ii, first_AP, next_AP, pre_AP, ISI localobj valid_ap_times
	
	stimul()	
	burst_spike_count = new Vector()
	
	printf("All APs for threshold compartment: %d. ", thresh_cmprt_ap_times.size())
	//printf("ALl AP times:")
	//ap_times_soma.printf()
	//print "Debug"
	//print min_spike_num
	
	if (thresh_cmprt_ap_times.size() < min_spike_num ) {
		firing_rate = 0
		printf("Less than %d.\n", min_spike_num)
		return 0
	} else {
		valid_ap_times = new Vector()
		ind_valid_AP1 = thresh_cmprt_ap_times.indwhere(">=", t_ss_start)
		ind_valid_AP2 = thresh_cmprt_ap_times.indwhere(">", t_ss_end)
		//print ind_valid_firing
		if ( ind_valid_AP1 == -1 ) {
			firing_rate = 0
			printf("No valid AP found within steady state of stimulation waveform.\n")
			return 0
		} else {
			if ( ind_valid_AP2 == -1 ) { 
				valid_ap_times.copy( thresh_cmprt_ap_times, ind_valid_AP1, thresh_cmprt_ap_times.size()-1 )
			} else {
				if ((ind_valid_AP2 - 1) >= ind_valid_AP1) {
					valid_ap_times.copy(thresh_cmprt_ap_times, ind_valid_AP1, ind_valid_AP2 - 1)
				}
			}
			printf("Valid APs: %d. ", valid_ap_times.size())
			//printf("Valid AP times: ")
			// valid_ap_times.printf()
			if (valid_ap_times.size() < min_spike_num ) {
				firing_rate = 0
				printf("Less than %d.\n", min_spike_num)
				return 0
			} else {
				printf("\n")
				count_burst = 0
				ii = 0
				while (ii < valid_ap_times.size()) {
					first_AP = valid_ap_times.x[ii]
					pre_AP = first_AP
					count_burst += 1
					in_burst = 1
					burst_spike_count.append(1)
					//printf("\tBurst No. %d: \n\t\tFirst AP at %3.2f ms.\n", count_burst, first_AP)
					
					ii += 1
					while (ii < valid_ap_times.size() && in_burst) {
						next_AP = valid_ap_times.x[ii]		
						//Consecutive spikes with inter-spike interval <=15 ms, which occurred during a period of 50 ms or less, were defined as a spiking burst.
						ISI = next_AP - pre_AP
						if ( ISI <= 15 && next_AP - first_AP <= 50 ) {
							pre_AP = next_AP							
							burst_spike_count.x[count_burst-1] += 1
							ii += 1
						} else {
							in_burst = 0
						}
						//printf("\t\tAP at %3.2f ms, ISI %3.2f ms. \n\t\t\tWithin burst: %s. Spikes count within burst: %d.\n", next_AP,ISI, NoYes.o(in_burst).s, burst_spike_count.x[count_burst-1])
					
					}
					//printf("\t\tTotal spikes within Burst No. %d: %d.\n", count_burst, burst_spike_count.x[count_burst-1])
				}
				printf("Total number of burst: %d.\n", count_burst)
				if (burst_spike_count.size()>0) {
					printf("\tAverage spike count per burst %1.2f. \n",burst_spike_count.mean())
				} 
				firing_rate = (count_burst) / ((t_ss_end - t_ss_start)/1000)
				printf("\tAverage firing rate %1.2f Hz.\n", firing_rate)
				
				return count_burst >= min_spike_num
			}
		}
	}
}


proc threshold() { local low, high, t1, sign, thresh_flag 
	// the "call by reference" arg $&1 is the independent variable
	t1 = startsw() // used to make sure threshold finder doesn't run longer than 24 hours
	
	if (AMP == 0) { AMP = 20 }
	if (AMP < 0) { sign = -1} else { sign = 1 }
	
	high = thresh_high * sign  // search within 1000 V/m
	low = thresh_low * sign
	
	printf("Initial amplitude: %3.3f\n", AMP)
	thresh_flag = thresh_excited()
	
	if (thresh_flag) {
		while ( thresh_flag ) {
			high = AMP
			printf("Suprathreshold! Upper bound: %3.3f. ", high)
			if ( (abs(high) > thresh_low) && (startsw() - t1 < max_time) ) {
				AMP /= scale_factor
				printf("Decreased amplitude: %3.3f.\n\n", AMP)
				thresh_flag = thresh_excited()
			} else {
				thresh_flag = 0
			}
		}
		if (startsw() - t1 > max_time) {
			printf("Threshold search ran for longer than %g sec!! Exiting.\n\n", max_time)
			AMP = 0
			return
		} else if (abs(high) < thresh_low) {
			printf("No lower bound found within preset range!! Exiting.\n\n")
			AMP = 0
			return
		} else {
			low = AMP
			printf("Subthreshold! Lower bound: %3.3f. Upper bound: %3.3f.\n\n", low, high)
		}
	} else {
		while ( thresh_flag == 0 ) {
			low = AMP
			printf("Subthreshold! Lower bound: %3.3f. ", low)
				if ( (abs(low) < thresh_high) && (startsw() - t1 < max_time) ) {
				AMP *= scale_factor
				printf(" Increased amplitude: %3.3f.\n\n", AMP)
				thresh_flag = thresh_excited()
			} else {
			    thresh_flag = 1
			}
		}
		if (startsw() - t1 > max_time) {
			printf("Threshold search ran for longer than %g sec!! Exiting.\n\n", max_time)
			AMP = thresh_high
			return
		} else if (abs(low) > thresh_high) {
			printf("No upper bound found within preset range!! Exiting.\n\n")
			AMP = thresh_high
			return
		} else {
			high = AMP
			printf("Suprathreshold! Lower bound: %3.3f. Upper bound: %3.3f. ", low, high)
		}
	}
	
	
	// exp(log(2)/2^5) = 1.022 -> 2.2%
	// exp(log(2)/2^6) = 1.011 -> 1.1%
	// within 2.5% accuracy means 5 threshold searches to narrow the bounds
	// another geometric mean -> exp(log(2)/2^6) = 1.011 -> 1.1% difference from upper and lower bounds
	// within 2% accuracy means 6 threshold searches to narrow the bounds
	// another geometric mean -> exp(log(2)/2^7) = 1.005 -> 0.54% difference from upper and lower bounds
	count_search = 0
	
	while ( abs( high/low - 1 ) >  thresh_acc ) {
		AMP = sign * sqrt(high * low)
		count_search = count_search + 1
		printf("Testing amplitude: %3.3f.\n\n", AMP)
		if (thresh_excited()) {
			high = AMP
			printf("Suprathreshold! Lower bound: %3.3f. Upper bound: %3.3f. ", low, high)
		} else {
			low = AMP
			printf("Subthreshold! Lower bound: %3.3f. Upper bound: %3.3f. ", low, high)
		}
		if (stoprun) break
	}
	
	AMP = sign * sqrt(high * low)		
	printf("Threshold bounded within %1.2f%%. Geometric mean of bounds: %3.3f. \n\n",(exp( log(scale_factor) / (2^count_search) ) - 1 ) * 100,  AMP)
	printf("**End of threshold().\n\n\n")
}
