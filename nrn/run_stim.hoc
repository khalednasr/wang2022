/** Simulation control **/

proc init_run() {
	getParams()			// get parameters from MATLAB
	cell_chooser()		// create cell
	getes()				// get newest extracellular potentials
	load_stim_waveform()
	init_AP_record()
	printf("****End of init_run().\n\n\n")
}

proc run_stim() {
	init_vm_record_4()
	stimul()
	save_data_thresh()
	//save firing rate?
}
proc run_block_filt() {
	load_filters()
	init_vm_record_5()
	thresh_blocked_filt()
	save_data_block()
	//save firing rate?
}

proc find_thresh() { 
	threshold() // threshold
	init_vm_record_4()
	rerun()
	save_data_thresh()		
	save_thresh()
	
	printf("****End of find_thresh().\n\n\n")
}

proc find_block() { 
	/*if (AMP >= thresh_high / thresh_factor ) {
		AMP = AMP * thresh_factor
	} else {
		AMP = AMP * block_factor
	}*/
	init_vm_record_1()
	threshold_block() // threshold
	init_vm_record_5()
	rerun_block()
	save_data_block()
	save_block()
	
	printf("****End of find_block().\n\n\n")
}

proc find_block_filt() { 
	/*if (AMP >= thresh_high / thresh_factor ) {
		AMP = AMP * thresh_factor
	} else {
		AMP = AMP * block_factor
	}*/
	
	/*
	{
