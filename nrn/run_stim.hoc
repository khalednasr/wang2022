proc stimul() {
	finitialize(v_init)
	setstim(AMP) // set amplitude of stimulation waveform
	printf("Running stimulation with E1 = %.3f V/m... ", AMP) // print E-field amplitude
	run()
	printf("Finished run.\n")
}


proc rerun() { local ii, inc
	// //
	/*if (dt >= 0.025) {
		dt = 0.025
		steps_per_ms = 1 / dt
		printf("Changing dt to %g ms for recording.\n", dt)
	}
	while (thresh_excited() == 0) {
		AMP = AMP * 1.005 	// make sure threshold value is at/above threshold for saving vm vs. t data		
		printf("Amplitude subthreshold. Increasing by 0.5%% to: %3.3f.\n",  AMP)
	}		
	printf("Amplitude suprathreshold.\n")
	*/
	// //
	
	/*
	if (dt > 0.020) {
		dt = 0.020
		steps_per_ms = 1 / dt
		printf("Changing dt to %g ms for recording.\n", dt)
	}*/
	
	if ( (abs(AMP) <= thresh_low ) || (abs(AMP) >= thresh_high) ) {
		printf("No threshold bounds found. Exiting after recording.\n")
		thresh_excited()
	} else {
		printf("Testing geometric mean of bounds.\n")
		inc = exp( log(scale_factor) / ( 2^(count_search+1) ) )
		if (thresh_excited() == 0) {
			AMP = AMP * inc
			printf("Amplitude subthreshold. Rerun upper bound for recording.\n")
			thresh_excited()
		} else {
			printf("Amplitude suprathreshold.\n")
		}
		
		printf("Achieved %1.2f%% accuracy. Final threshold amplitude = %3.3f.\n", (inc-1) * 100, AMP)
	}
	
	//printf("E-field 1: theta = %g degree, phi = %g degree, threshold amplitude = %f V/m.\n",theta1, phi1, AMP)
	//printf("E-field 2: theta = %g degree, phi = %g degree.\n",theta2, phi2)
}

proc rerun_block() { local ii, inc
	// //
	/*if (dt >= 0.025) {
		dt = 0.025
		steps_per_ms = 1 / dt
		printf("Changing dt to %g ms for recording.\n", dt)
	}
	while (thresh_excited() == 0) {
		AMP = AMP * 1.005 	// make sure threshold value is at/above threshold for saving vm vs. t data		
		printf("Amplitude subthreshold. Increasing by 0.5%% to: %3.3f.\n",  AMP)
	}		
	printf("Amplitude suprathreshold.\n")
	*/
	// //
	
	/*
	if (dt > 0.020) {
		dt = 0.020
		steps_per_ms = 1 / dt
		printf("Changing dt to %g ms for recording.\n", dt)
	}*/
	
	if ( (abs(AMP) <= block_low ) || (abs(AMP) >= block_high) ) {
		printf("No block threshold bounds found. Exiting after recording.\n")
		thresh_blocked()
	} else {
		printf("Testing geometric mean of bounds.\n")
		inc = exp( log(scale_factor) / ( 2^(count_search+1) ) )
		if (thresh_blocked() == 0) {
			AMP = AMP * inc
			printf("Amplitude sub-block-threshold. Rerun upper bound for recording.\n")
			thresh_blocked()
		} else {
			printf("Amplitude supra-block-threshold.\n")
		}
		
		printf("Achieved %1.2f%% accuracy. Final block-threshold amplitude = %3.3f.\n", (inc-1) * 100, AMP)
	}
	
	//printf("E-field 1: theta = %g degree, phi = %g degree, threshold amplitude = %f V/m.\n",theta1, phi1, AMP)
	//printf("E-field 2: theta = %g degree, phi = %g degree.\n",theta2, phi2)
}


proc rerun_block_filt() { local ii, inc

	
	if ( (abs(AMP) <= block_low ) || (abs(AMP) >= block_high) ) {
		printf("No block threshold bounds found. Exiting after recording.\n")
		thresh_blocked_filt()
	} else {
		printf("Testing geometric mean of bounds.\n")
		inc = exp( log(scale_factor) / ( 2^(count_search+1) ) )
		if (thresh_blocked_filt() == 0) {
			AMP = AMP * inc
			printf("Amplitude sub-block-threshold. Rerun upper bound for recording.\n")
			thresh_blocked_filt()
		} else {
			printf("Amplitude supra-block-threshold.\n")
		}
		
		printf("Achieved %1.2f%% accuracy. Final block-threshold amplitude = %3.3f.\n", (inc-1) * 100, AMP)
	}
	
	//printf("E-field 1: theta = %g degree, phi = %g degree, threshold amplitude = %f V/m.\n",theta1, phi1, AMP)
	//printf("E-field 2: theta = %g degree, phi = %g degree.\n",theta2, phi2)
}
