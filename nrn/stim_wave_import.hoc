proc setstim() {
	
	stim1_amp.copy(stim1_amp_norm)
	stim2_amp.copy(stim2_amp_norm)
	
	stim1_amp.mul(AMP)
	stim2_amp.mul(AMP)
	attach_stim()
	//plot_waveform(AMP)
	if (st_mode == 2) {
		curr_waveform()		
		attach_curr()
		plot_curr_waveform(st_amp)
	}

}

proc load_stim_waveform() {
	stim_waveform()
	
	stim1_amp = new Vector()
	stim2_amp = new Vector()
	
	stim1_amp.copy(stim1_amp_norm)
	stim2_amp.copy(stim2_amp_norm)
	
	attach_stim()
	printf("**End of load_stim_waveform().\n\n")	
	//plot_waveform(1) //visualize stimulation waveform
	
	/*if (st_mode == 2) {
		curr_waveform()		
		attach_curr()
		plot_curr_waveform(st_amp)
	}*/
}

proc stim_waveform() { localobj Efile, tfile, Efile_name, tfile_name
	tfile_name = new String()
	sprint(tfile_name.s,"Params/%s/tvec.txt",run_name.s)
	tfile = new File() 
	tfile.ropen(tfile_name.s)
	stim_time = new Vector()
	stim_time.vread(tfile)
	tfile.close()
	
	Efile_name = new String()
	sprint(Efile_name.s,"Params/%s/E1_vec.txt",run_name.s)
	Efile = new File()
	Efile.ropen(Efile_name.s)
	stim1_amp_norm = new Vector()
	stim1_amp_norm.vread(Efile)
	Efile.close()
	
	Efile_name = new String()
	sprint(Efile_name.s,"Params/%s/E2_vec.txt",run_name.s)
	
	Efile = new File()
	Efile.ropen(Efile_name.s)
	stim2_amp_norm = new Vector()
	stim2_amp_norm.vread(Efile)
	Efile.close()
	
	printf("Read E1, E2, and t vectors from files.\n")  
}


proc attach_stim() {
	forall {
		if (ATTACHED__ == 0) { // don't bother if stim is already attached to something
			if (ismembrane("xtra")) {
				stim1_amp.play(&stim1_xtra, stim_time, 1) 
				stim2_amp.play(&stim2_xtra, stim_time, 1)        				
				ATTACHED__ = 1
			}
		}
	}
}

proc curr_waveform() { localobj Ifile, Ifile_name
	Ifile_name = new String()
	sprint(Ifile_name.s,"Params/%s/I_vec.txt",run_name.s)
	Ifile = new File() 
	Ifile.ropen(Ifile_name.s)
	curr_amp = new Vector()
	curr_amp.vread(Ifile)
	Ifile.close()
	printf("Read I vector from file.\n")
}

proc attach_curr() {
	curr_amp.play(&st.amp, stim_time, 1)
}

// Plot waveform

objref g1,g1_2,g2
proc plot_waveform() {
	g1 = new Graph(0)
	g1.size(0,stim_time.size(),-1, $1)
	stim1_amp.plot(g1,stim_time)
	g1.view(0,-$1,stim_time.x[stim_time.size()-1],$1-(-$1),800,150, 300.48, 200.32) 
	
	g1_2 = new Graph(0)
	g1_2.size(0,stim_time.size(),-1, $1)
	stim2_amp.plot(g1_2,stim_time)
	g1_2.view(0,-$1,stim_time.x[stim_time.size()-1],$1-(-$1),1000,350, 300.48, 200.32)
}

proc plot_curr_waveform() {
	g2 = new Graph(0)
	g2.size(0,stim_time.size(),-1, $1)
	curr_amp.plot(g2,stim_time)
	g2.view(0,-$1,stim_time.x[stim_time.size()-1],$1-(-$1),800,150, 300.48, 200.32) 
}



