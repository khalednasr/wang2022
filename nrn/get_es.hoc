// MATLAB script V_data produces text file with single vector of calculated potential for 
// every segment coordinate. This procedure assigns each potential to its respective node 
// in es_xtra(x), which is a range variable that points to e_extracullar
// es_xtra(x) is scaled with the stimulation waveform contained in stim_waveform.hoc


proc getes() {

	if (cell_rotated == 0) {
		x_rotate(cell.all) 		// sets cell_rotated to 1
		printf("Rotated cell.\n")	
	}
	setpointers()	
	
	// Calculate potentials for uniform E-field in NEURON 
	calces1(theta1,phi1)
	calces2(theta2,phi2)
	printf("Calculated E-field potentials in NEURON for theta1 = %g, phi1 = %g & theta2 = %g, phi2 = %g with cell_rotated: %s.\n",theta1, phi1, theta2, phi2, NoYes.o(cell_rotated).s)		
	printf( "Saved to es_xtra(x).\n")
	printf("**End of getes().\n\n")
}


// input theta, and phi angles of E-field
proc calces1() { local theta1, phi1, Ex1, Ey1, Ez1
	theta1 = $1 * deg2rad
	phi1 = $2 * deg2rad
	Ex1 = sin(theta1)*cos(phi1)
	Ey1 = sin(theta1)*sin(phi1)
	Ez1 = cos(theta1)
	forall {
		if (ismembrane("xtra")) {
			for(x,0){
				es1_xtra(x) = -(Ex1*x_xtra(x) + Ey1*y_xtra(x) + Ez1*z_xtra(x))*1e-3 // Ve in [mV] <= um*1e-3 = mm * 1mV/mm = mV
			}
		}
	}
}

// input theta and phi angles of second E-fields theta2, phi2, relative strength vs first E-field is scaled by stim2 vector loaded from file
proc calces2() { local theta2, phi2, Ex2, Ey2, Ez2
	theta2 = $1 * deg2rad
	phi2 = $2 * deg2rad
	Ex2 = sin(theta2) * cos(phi2)
	Ey2 = sin(theta2) * sin(phi2)
	Ez2 = cos(theta2)
	forall {
		if (ismembrane("xtra")) {
			for(x,0){
				es2_xtra(x) = -(Ex2 * x_xtra(x) + Ey2 * y_xtra(x) + Ez2 * z_xtra(x))*1e-3 // Ve in [mV] <= um*1e-3 = mm * 1mV/mm = mV
			}
		}
	}
}

