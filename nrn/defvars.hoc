// run_stim
objref graph_filt
objref A_HPF, B_HPF, A_BSF, B_BSF
HPF_n = 4
B_HPF = new Vector(HPF_n)
A_HPF = new Vector(HPF_n)
BSF_n = 11
B_BSF = new Vector(BSF_n)
A_BSF = new Vector(BSF_n)

// read filter parameter with dt set in MATLAB
proc load_filters() { localobj coef_name, coef_file
	coef_name = new String()
	sprint(coef_name.s,"Params/%s/B_HPF.txt",run_name.s)
	coef_file = new File() 
	coef_file.ropen(coef_name.s)
	B_HPF.vread(coef_file)
	coef_file.close()
	
	coef_name = new String()
	sprint(coef_name.s,"Params/%s/A_HPF.txt",run_name.s)
	coef_file = new File() 
	coef_file.ropen(coef_name.s)
	A_HPF.vread(coef_file)
	coef_file.close()
	
	
	coef_name = new String()
	sprint(coef_name.s,"Params/%s/B_BSF.txt",run_name.s)
	coef_file = new File() 
	coef_file.ropen(coef_name.s)
	B_BSF.vread(coef_file)
	coef_file.close()
	
	coef_name = new String()
	sprint(coef_name.s,"Params/%s/A_BSF.txt",run_name.s)
	coef_file = new File() 
	coef_file.ropen(coef_name.s)
	A_BSF.vread(coef_file)
	coef_file.close()
	
	
	printf("Read A_HPF, B_HPF, A_BSF, and B_BSF vectors from files.\n")  
}
