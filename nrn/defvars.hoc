replace_ax = 0
prune_ax = 0
myelinate_ax = 0
mod_ax = 0
scale_ax = 1
scale_mainax = 1
scale_apic_diam = 1
scale_basal_diam = 1
scale_soma_area = 1
scale_basal_L = 1
min_myelinD = 0
max_myelin_order = 0
ss_init = 1
//v_init
temp = 37
//dt
record_dt = 0.025
//tstop
cmprt = 1			// cmprt for finding threshold: 1-4 = 'soma','term','AIS','node0'
AMP = 1				// initial amplitude of E-field 1
theta1 = 180
phi1 = 0
theta2 = 90 		// orientation of E-field 2
phi2 = 180
min_spike_num = 1
t_ss_start = 750	// start of steady state for counting spikes
t_ss_end = 4750
st_amp = 0 		// for IClamp 
st_del = 0
st_dur = 0
st_mode = 1 	// current injection mode


//synaptic parameters
n_synapses = 55
